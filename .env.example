# Lodestar environment — copy to `.env` and fill in. NEVER commit the real `.env`
# (it's gitignored, and the pre-commit secret scan will block obvious keys).
# A pre-commit hook is configured in .pre-commit-config.yaml — install it once with:
#   pip install pre-commit && pre-commit install

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# Use the service-role key (read + write). Treat it as a secret; rotate if leaked.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── Toqan agents ──────────────────────────────────────────────────────────────
# One API key per agent (created in Toqan). The base URL has a default; override only if needed.
TOQAN_API_URL=https://api.toqan.ai
# Answer-poll budget for every agent = attempts × interval seconds (default 300×5 = 25 min).
# Raise TOQAN_MAX_POLL_ATTEMPTS if the Strategist (the heaviest agent) still times out.
# TOQAN_MAX_POLL_ATTEMPTS=300
# TOQAN_POLL_INTERVAL=5
# Web-request poll budget for Ask only (kept far below the pipeline's 25-min budget
# so a slow Toqan spell can't pin server threads and melt the web tier). 36 = 3 min.
# TOQAN_ASK_MAX_POLL_ATTEMPTS=36
# Feed agents (one per feed in feeds.py) — a feed with no key is simply skipped.
TOQAN_HOME_PAGE_NEWS=your-ev-feed-agent-key
TOQAN_AI_ENERGY_NEWS=your-ai-energy-agent-key
TOQAN_DISRUPTIVE_TECH=your-disruptive-tech-agent-key
TOQAN_CHIPS_NEWS=your-chips-agent-key
TOQAN_GEOPOLITICS_NEWS=your-geopolitics-agent-key
TOQAN_CLIMATE_NEWS=your-climate-agent-key
TOQAN_BIOTECH_NEWS=your-biotech-agent-key
TOQAN_SOFTWARE_NEWS=your-software-cyber-agent-key
TOQAN_FINTECH_NEWS=your-fintech-agent-key
TOQAN_DEFENSE_NEWS=your-defense-space-agent-key
TOQAN_PROSUS_NEWS=your-prosus-portfolio-agent-key
# Analytics agents
TOQAN_MOT_LENS=your-mot-lens-agent-key
TOQAN_STRATEGIST=your-strategist-agent-key
TOQAN_ASK=your-ask-agent-key
# Each of the five below degrades gracefully when unset — the caller falls back to
# a deterministic path rather than erroring — so leave them blank until you have
# the agent. Unset means "quietly reduced quality", not "broken", which is easy to
# miss when handing this repo to someone else.
# Company dossiers (analytics/dossier_agent.py).
TOQAN_DOSSIER=your-dossier-agent-key
# Narrative analyst commentary (analytics/analyst.py).
TOQAN_ANALYST=your-analyst-agent-key
# Radar scout tagging; without it backend/app/actions.py uses the tag fallback.
TOQAN_SCOUT=your-scout-agent-key
# Judges thesis-falsifying evidence (falsifier_run.py).
TOQAN_FALSIFIER_JUDGE=your-falsifier-judge-agent-key
# Explains S-curve transition alerts (transition_alerts_run.py).
TOQAN_TRANSITION_WHY=your-transition-why-agent-key

# ── OpenAI (MOT knowledge-base embeddings, for the theory search / Strategist citations) ──
OPENAI_API_KEY=sk-your-openai-key
# Optional — sensible defaults in config.py:
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=2000

# ── Admin auth (gates the Prosus page + agent-triggering actions on the live app) ──
# A single shared admin login. If any of the three is unset, admin login is
# disabled and every gated endpoint denies access (fails closed).
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
# Long random string used to sign session tokens (e.g. `openssl rand -hex 32`).
AUTH_SECRET=your-long-random-auth-secret

# ── Alerts / monitoring (optional) ────────────────────────────────────────────
# Slack/Discord-style incoming webhook for watchlist alerts (alerts_run.py), the
# freshness monitor (freshness_check.py), and falsifier/thesis evidence alerts
# (falsifier_run.py). Leave unset to disable webhook alerts.
ALERT_WEBHOOK=
# ALERT_WINDOW_HOURS=8
# How far back falsifier watch scans for candidate evidence (default 1 day —
# matched to the 6h pipeline cadence with headroom).
# FALSIFIER_WINDOW_DAYS=1
# Error tracking on the API serving path — set a Sentry DSN to enable
# (requires `pip install sentry-sdk`); unset = disabled, zero cost.
# SENTRY_DSN=
# API log verbosity (python logging level). Default INFO.
# LOG_LEVEL=INFO

# ── Web service tuning (optional; defaults are production-safe) ───────────────
# Set WARM_CACHE=0 to disable the background cache warmer (tests / local dev
# without Supabase). Leave unset in production.
# WARM_CACHE=1
# Extra allowed browser origins for the API, comma-separated. ONLY needed if the
# SPA is served from a DIFFERENT origin than the API (e.g. separate static host).
# On DigitalOcean App Platform per .do/app.yaml both share one origin — leave unset.
# CORS_ALLOW_ORIGINS=https://your-spa-host.example

# ── Frontend build (NOT this file) ────────────────────────────────────────────
# VITE_API_URL is a BUILD-TIME variable for the React app, read from
# frontend/.env or the static-site build environment — not from this backend .env.
# Set it ONLY when the SPA and API live on different origins; leave unset when
# they share one origin (Vite dev proxy / DO single-domain routing).
# VITE_API_URL=https://api.your-host.example
